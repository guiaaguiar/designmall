---
/**
 * Logo Design Mall (vetor extraído do manual de identidade).
 * - variant="full": ícone + DESIGN + MALL
 * - variant="icon": apenas a sacola
 * Cores controladas por CSS: --logo-ink (DESIGN, alça e X) e --logo-accent (sacola e MALL).
 */
interface Props {
  variant?: 'full' | 'icon';
  class?: string;
  title?: string;
}
const { variant = 'full', class: className = '', title = 'Design Mall' } = Astro.props;
// O ícone ocupa x 0 → 91 no desenho completo.
const viewBox = variant === 'icon' ? '0 0 91 124.5' : '0 0 399.48 142.48';
---

<svg
  class:list={['logo', `logo--${variant}`, className]}
  viewBox={viewBox}
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={title}
>
  <g class="logo__icon">
    <g class="logo__bag" fill="var(--logo-accent, #F05F8E)">
      <path d="M17.12 39.04L21.96 37.5L21.96 29.79L9.75 33.72L9.75 51.36L17.12 51.36L17.12 39.04" />
      <path d="M69.4 14.65L69.4 23.88L83.6 34.16L83.6 104.93L67.89 116.3L17.12 100.05L17.12 88.28L9.75 88.28L9.75 105.37L69.02 124.44L69.28 124.53L90.97 108.56L90.97 30.53L69.4 14.65" />
    </g>
    <g class="logo__handle" fill="var(--logo-ink, #EEEEEE)">
      <path d="M36.07 37.63L36.07 20.79C36.07 12.76 40.4 5.97 45.52 5.97C50.65 5.97 54.98 12.76 54.98 20.79L54.98 37.63L60.95 37.63L60.95 20.79C60.95 9.13 54.17 0 45.52 0C36.87 0 30.09 9.13 30.09 20.79L30.09 37.63L36.07 37.63" />
    </g>
    <g class="logo__x" fill="var(--logo-ink, #EEEEEE)">
      <path d="M26.78 60.44L22.84 56.52L13.39 66.01L3.95 56.52L0 60.44L9.47 69.96L0 79.47L3.95 83.4L13.39 73.9L22.84 83.4L26.78 79.47L17.32 69.96L26.78 60.44" />
