---
/**
 * Mosaico de grafismos. Gera uma composição determinística (mesma `seed`
 * = mesmo desenho) e anima as peças ao entrar na tela. Com `live`, uma peça
 * gira de tempos em tempos — a marca "respira" sem distrair.
 */
import Tile from './Tile.astro';
import { tileKinds, type TileKind } from './tiles';

interface Props {
  cols: number;
  rows: number;
  seed?: number;
  live?: boolean;
  class?: string;
  kinds?: TileKind[];
}

const {
  cols,
  rows,
  seed = 7,
  live = false,
  class: className = '',
  kinds = tileKinds,
} = Astro.props;

// PRNG simples e determinístico (mulberry32)
let s = seed >>> 0;
const rand = () => {
  s = (s + 0x6d2b79f5) >>> 0;
  let t = s;
  t = Math.imul(t ^ (t >>> 15), t | 1);
  t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
};

const total = cols * rows;
const tiles = Array.from({ length: total }, (_, i) => {
  // evita a mesma forma lado a lado
  const kind = kinds[Math.floor(rand() * kinds.length)];
  return { kind, rotate: Math.floor(rand() * 4) * 90, i };
});
for (let i = 1; i < tiles.length; i++) {
  if (tiles[i].kind === tiles[i - 1].kind) {
    tiles[i].kind = kinds[(kinds.indexOf(tiles[i].kind) + 1) % kinds.length];
  }
}
---

<div
  class:list={['mosaic', className]}
  style={`--cols:${cols};--rows:${rows}`}
  data-mosaic
  data-live={live ? '' : undefined}
  aria-hidden="true"
>
  {tiles.map((t) => <Tile kind={t.kind} rotate={t.rotate} style={`--i:${t.i}`} />)}
</div>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

  function setupMosaic(el: HTMLElement) {
    const tiles = Array.from(el.querySelectorAll<HTMLElement>('.tile'));
    let timer = 0;

    const spin = () => {
      const tile = tiles[Math.floor(Math.random() * tiles.length)];
      if (!tile) return;
      const current = Number.parseInt(getComputedStyle(tile).getPropertyValue('--r')) || 0;
      tile.style.setProperty('--r', `${current + 90}deg`);
    };

    const io = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          el.classList.add('is-in');
          if (el.hasAttribute('data-live') && !reduce.matches && !timer) {
            timer = window.setInterval(spin, 2200);
          }
        } else if (timer) {
          window.clearInterval(timer);
          timer = 0;
        }
      },
      { threshold: 0.15 },
    );
    io.observe(el);
  }

  document.querySelectorAll<HTMLElement>('[data-mosaic]').forEach(setupMosaic);
</script>
