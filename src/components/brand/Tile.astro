---
/**
 * Um "grafismo" da identidade Design Mall — formas geométricas que simbolizam
 * conexões entre pessoas, culturas e estilos (manual, pág. 13).
 * Sempre decorativo.
 */
import type { TileKind } from './tiles';

interface Props {
  kind: TileKind;
  /** rotação em graus (múltiplos de 90) */
  rotate?: number;
  class?: string;
  style?: string;
}

const { kind, rotate = 0, class: className = '', style = '' } = Astro.props;

const P = 'var(--color-purple)';
const V = 'var(--color-violet)';
const K = 'var(--color-pink)';
const T = 'var(--color-teal)';
---

<span
  class:list={['tile', `tile--${kind}`, className]}
  style={`--r:${rotate}deg;${style}`}
  aria-hidden="true"
>
  <svg viewBox="0 0 100 100" preserveAspectRatio="none" focusable="false">
    {
      kind === 'arch' && (
        <>
          <rect width="100" height="100" fill={P} />
          <path d="M0 100A50 50 0 0 1 100 100Z" fill={T} />
          <path d="M18 100A32 32 0 0 1 82 100Z" fill={V} />
          <path d="M36 100A14 14 0 0 1 64 100Z" fill={P} />
        </>
      )
    }
    {
      kind === 'quarter' && (
        <>
          <rect width="100" height="100" fill={P} />
          <path d="M0 0H100A100 100 0 0 1 0 100Z" fill={K} />
        </>
      )
    }
    {
      kind === 'half' && (
        <>
          <rect width="100" height="100" fill={P} />
          <path d="M0 50A50 50 0 0 1 100 50Z" fill={K} />
          <path d="M0 50A50 50 0 0 0 100 50Z" fill={V} />
        </>
      )
    }
    {
      kind === 'triangles' && (
        <>
          <rect width="100" height="100" fill={V} />
          <path d="M0 0H100L50 50Z" fill={T} />
          <path d="M0 100L50 50L100 100Z" fill={K} />
        </>
      )
    }
    {
      kind === 'chevron' && (
        <>
          <rect width="100" height="100" fill={P} />
          <path
            d="M-5 8L25 -8L55 8L85 -8L115 8M-5 33L25 17L55 33L85 17L115 33M-5 58L25 42L55 58L85 42L115 58M-5 83L25 67L55 83L85 67L115 83M-5 108L25 92L55 108L85 92L115 108"
            fill="none"
            stroke={K}
            stroke-width="8"
            stroke-linejoin="miter"
          />
        </>
      )
    }
    {
      kind === 'bullseye' && (
        <>
          <rect width="100" height="100" fill={V} />
          <circle cx="50" cy="50" r="50" fill={T} />
          <circle cx="50" cy="50" r="31" fill={P} />
          <path d="M19 50A31 31 0 0 1 81 50Z" fill={K} />
        </>
      )
    }
  </svg>
</span>
