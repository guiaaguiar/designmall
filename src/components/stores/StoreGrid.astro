---
/**
 * Grade de lojas com filtro por categoria.
 * Reutilizada na landing (seção "stores") e na página /lojas.
 */
import StoreCard from './StoreCard.astro';
import Icon from '../ui/Icon.astro';
import type { Category, Store } from '../../lib/content/schema';

interface Props {
  stores: Store[];
  categories: Category[];
  showFilters?: boolean;
  allLabel?: string;
  /** exibe busca por nome (página /lojas) */
  searchable?: boolean;
}

const { stores, categories, showFilters = true, allLabel = 'Todas', searchable = false } = Astro.props;
const catById = new Map(categories.map((c) => [c.id, c]));
const usedCategories = categories.filter((c) => stores.some((s) => s.categoryId === c.id));
---

<div class="store-grid" data-store-grid>
  {
    searchable && (
      <div class="store-grid__search">
        <label class="store-grid__search-label" for="busca-lojas">
          Buscar loja
        </label>
        <div class="store-grid__search-field">
          <Icon name="search" size={20} />
          <input id="busca-lojas" type="search" placeholder="Nome da loja, categoria ou piso" autocomplete="off" data-store-search />
        </div>
      </div>
    )
  }
  {
    showFilters && usedCategories.length > 1 && (
      <div class="store-grid__filters" role="group" aria-label="Filtrar lojas por experiência">
        <button type="button" class="filter" aria-pressed="true" data-filter="">
          {allLabel}
          <span class="filter__count">{stores.length}</span>
        </button>
        {usedCategories.map((c) => (
          <button type="button" class="filter" aria-pressed="false" data-filter={c.slug} data-tone={c.tone}>
            <Icon name={c.icon} size={16} />
            {c.name}
          </button>
        ))}
      </div>
    )
  }

  <p class="store-grid__status" aria-live="polite" data-store-status>
    {stores.length} {stores.length === 1 ? 'loja' : 'lojas'}
  </p>

  <ul class="store-grid__list" role="list">
    {stores.map((store, i) => <StoreCard store={store} category={catById.get(store.categoryId ?? '')} index={i} />)}
  </ul>

  <p class="store-grid__empty" hidden data-store-empty>Nenhuma loja encontrada. Tente outra busca ou categoria.</p>
</div>

<style>
  .store-grid__filters {
    display: flex;
    gap: 0.5rem;
    margin-top: clamp(2rem, 4vw, 3rem);
    padding-bottom: 0.25rem;
    overflow-x: auto;
    scrollbar-width: none;
    mask-image: linear-gradient(90deg, #000 88%, transparent);
  }
  .store-grid__filters::-webkit-scrollbar {
    display: none;
  }
  @media (min-width: 1024px) {
    .store-grid__filters {
      flex-wrap: wrap;
      overflow: visible;
      mask-image: none;
    }
  }
  .filter {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    flex: none;
    min-height: 2.75rem;
    padding: 0 1.125rem;
    border-radius: 999px;
    background: var(--color-surface);
    box-shadow: inset 0 0 0 1px var(--color-line);
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-ink-soft);
    transition:
      background-color 0.25s ease,
      color 0.25s ease,
      box-shadow 0.25s ease,
      transform 0.35s var(--ease-spring);
  }
  .filter :global(.icon) {
    color: var(--tone, var(--color-ink-muted));
    transition: color 0.25s ease;
  }
  .filter:hover {
    color: var(--color-ink);
    box-shadow: inset 0 0 0 1px var(--color-line-strong);
  }
  .filter:active {
    transform: scale(0.96);
  }
  .filter[aria-pressed='true'] {
    background: var(--color-ink);
    color: var(--color-on-accent);
    box-shadow: none;
  }
  .filter[aria-pressed='true'] :global(.icon) {
    color: currentColor;
  }
  .filter__count {
    display: grid;
    place-items: center;
    min-width: 1.5rem;
    height: 1.5rem;
    padding: 0 0.375rem;
    border-radius: 999px;
    background: rgb(35 32 33 / 0.12);
    font-size: 0.75rem;
  }

  .store-grid__search {
    max-width: 34rem;
  }
  .store-grid__search-label {
    display: block;
    margin: 0 0 0.5rem 1.25rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-ink-soft);
  }
  .store-grid__search-field {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0 1.25rem;
    border-radius: 999px;
    background: var(--color-surface);
    box-shadow: inset 0 0 0 1px var(--color-line-strong);
    color: var(--color-ink-muted);
    transition: box-shadow 0.25s ease;
  }
  .store-grid__search-field:focus-within {
    box-shadow:
      inset 0 0 0 2px var(--color-teal),
      0 0 0 6px rgb(36 175 193 / 0.15);
  }
  .store-grid__search-field input {
    flex: 1;
    min-width: 0;
    height: 3.25rem;
    border: 0;
    background: transparent;
    color: var(--color-ink);
    font-size: 1rem;
    outline: none;
  }

  .store-grid__status {
    margin-top: 1.5rem;
    font-size: 0.875rem;
    color: var(--color-ink-muted);
  }

  .store-grid__list {
    display: grid;
    gap: 1rem;
    margin-top: 1rem;
    /* celular: 2 colunas compactas (a lista de 12 lojas não vira uma rolagem interminável) */
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }
  @media (min-width: 560px) {
    .store-grid__list {
      gap: 1rem;
    }
  }
  @media (min-width: 900px) {
    .store-grid__list {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (min-width: 1200px) {
    .store-grid__list {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .store-grid__empty {
    padding: 3rem 0;
    text-align: center;
    color: var(--color-ink-muted);
  }
</style>

<script>
  type VT = Document & { startViewTransition?: (cb: () => void) => unknown };
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('[data-store-grid]').forEach((grid) => {
    const buttons = Array.from(grid.querySelectorAll<HTMLButtonElement>('[data-filter]'));
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('.store-card'));
    const status = grid.querySelector<HTMLElement>('[data-store-status]');
    const empty = grid.querySelector<HTMLElement>('[data-store-empty]');
    const search = grid.querySelector<HTMLInputElement>('[data-store-search]');
    let current = '';
    const normalize = (v: string) =>
      v.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().trim();

    const apply = (slug: string) => {
      current = slug;
      const term = search ? normalize(search.value) : '';
      let visible = 0;
      for (const card of cards) {
        const show = (!slug || card.dataset.category === slug) && (!term || (card.dataset.search ?? '').includes(term));
        card.hidden = !show;
        if (show) {
          visible++;
          card.classList.add('is-visible'); // garante que cards ainda não revelados apareçam
        }
      }
      buttons.forEach((b) => b.setAttribute('aria-pressed', String((b.dataset.filter ?? '') === slug)));
      if (status) status.textContent = `${visible} ${visible === 1 ? 'loja' : 'lojas'}`;
      if (empty) empty.hidden = visible > 0;
    };

    const filter = (slug: string) => {
      const doc = document as VT;
      if (doc.startViewTransition && !reduce.matches) doc.startViewTransition(() => apply(slug));
      else apply(slug);
    };

    buttons.forEach((b) => b.addEventListener('click', () => filter(b.dataset.filter ?? '')));
    search?.addEventListener('input', () => apply(current));

    // Cards de "Experiências" levam direto ao filtro correspondente
    document.querySelectorAll<HTMLAnchorElement>('[data-filter-link]').forEach((link) => {
      link.addEventListener('click', () => {
        const slug = link.dataset.filterLink ?? '';
        if (buttons.some((b) => b.dataset.filter === slug)) apply(slug);
      });
    });
  });
</script>
