---
/**
 * Capa provisória da loja: composição de grafismos única por loja (derivada do slug).
 * É exibida enquanto a loja não tiver `coverUrl` cadastrada.
 */
import Tile from '../brand/Tile.astro';
import { tileKinds } from '../brand/tiles';

interface Props {
  seed: string;
}

const { seed } = Astro.props;
let h = 0;
for (const ch of seed) h = (Math.imul(h, 31) + ch.charCodeAt(0)) >>> 0;
const tiles = Array.from({ length: 6 }, (_, i) => {
  h = (Math.imul(h ^ (h >>> 13), 0x5bd1e995) + i) >>> 0;
  return { kind: tileKinds[h % tileKinds.length], rotate: ((h >>> 4) % 4) * 90 };
});
---

<div class="store-cover" aria-hidden="true">
  {tiles.map((t) => <Tile kind={t.kind} rotate={t.rotate} />)}
</div>

<style>
  .store-cover {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: repeat(2, 1fr);
    filter: saturate(0.85);
  }
  .store-cover :global(.tile) {
    aspect-ratio: auto;
    width: 100%;
    height: 100%;
  }
</style>
