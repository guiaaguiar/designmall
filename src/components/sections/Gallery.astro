---
import SectionHeading from '../ui/SectionHeading.astro';
import type { SectionData } from '../../lib/content/schema';

interface Props {
  data: SectionData<'gallery'>;
  anchor: string | null;
}

const { data, anchor } = Astro.props;
const tones = ['pink', 'teal', 'violet'] as const;
---

{
  data.items.length > 0 && (
    <section class="section gallery" id={anchor ?? undefined}>
      <div class="container-site">
        <SectionHeading eyebrow={data.eyebrow} title={data.title} subtitle={data.subtitle} />

        <ul class="gallery__grid" role="list">
          {data.items.map((item, i) => (
            <li class="gallery__item" data-tone={tones[i % tones.length]} data-reveal="scale" style={`--delay:${i * 80}ms`}>
              <figure class="gallery__fig">
                <img
                  src={item.image.src}
                  srcset={item.image.srcset}
                  sizes={i === 0 ? '(min-width: 1024px) 58vw, 100vw' : '(min-width: 1024px) 34vw, 100vw'}
                  alt={item.image.alt}
                  loading="lazy"
                  decoding="async"
                />
                <figcaption>
                  {item.tag && <span class="gallery__tag">{item.tag}</span>}
                  <h3>{item.title}</h3>
                  {item.text && <p>{item.text}</p>}
                </figcaption>
              </figure>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<style>
  .gallery__grid {
    display: grid;
    gap: 1rem;
    margin-top: clamp(2.5rem, 5vw, 4rem);
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) {
    .gallery__grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .gallery__item:first-child {
      grid-column: span 2;
    }
  }
  @media (min-width: 1024px) {
    .gallery__grid {
      grid-template-columns: repeat(6, 1fr);
      grid-auto-rows: clamp(14rem, 20vw, 19rem);
    }
    .gallery__item:nth-child(1) {
      grid-column: span 4;
      grid-row: span 2;
    }
    .gallery__item:nth-child(2) {
      grid-column: span 2;
    }
    .gallery__item:nth-child(3) {
      grid-column: span 2;
    }
    .gallery__item:nth-child(4),
    .gallery__item:nth-child(5) {
      grid-column: span 3;
    }
  }

  .gallery__item {
    display: flex;
    min-height: 16rem;
  }
  .gallery__fig {
    position: relative;
    width: 100%;
    border-radius: var(--radius-card);
    overflow: hidden;
    isolation: isolate;
    background: var(--color-surface);
    box-shadow: inset 0 0 0 1px var(--color-line);
    transition: transform 0.5s var(--ease-spring), box-shadow 0.3s ease;
  }
  .gallery__fig:hover {
    transform: translateY(-4px);
    box-shadow:
      inset 0 0 0 1px color-mix(in srgb, var(--tone) 55%, transparent),
      0 28px 50px -28px color-mix(in srgb, var(--tone) 60%, transparent);
  }
  .gallery__fig img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
    transition: transform 1.2s var(--ease-out-expo);
  }
  .gallery__fig:hover img {
    transform: scale(1.06);
  }
  .gallery__fig::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to top, rgb(35 31 32 / 0.92) 0%, rgb(35 31 32 / 0.5) 42%, rgb(35 31 32 / 0) 72%);
  }
  .gallery__fig figcaption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: grid;
    gap: 0.375rem;
    justify-items: start;
    padding: clamp(1.1rem, 2vw, 1.75rem);
  }
  .gallery__tag {
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--tone) 22%, rgb(35 31 32 / 0.7));
    backdrop-filter: blur(8px);
    color: var(--tone);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .gallery__fig h3 {
    font-size: clamp(1.25rem, 2vw, 1.75rem);
    font-weight: 800;
  }
  .gallery__item:first-child h3 {
    font-size: clamp(1.5rem, 3vw, 2.5rem);
  }
  .gallery__fig p {
    max-width: 38ch;
    font-size: 0.9375rem;
    color: var(--color-ink-soft);
  }
</style>
