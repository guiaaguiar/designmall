---
import Icon from '../ui/Icon.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { dayAndMonth, formatDateRange, todayISO } from '../../lib/text';
import type { SectionData, SiteContent, Tone } from '../../lib/content/schema';

interface Props {
  data: SectionData<'events'>;
  anchor: string | null;
  content: SiteContent;
}

const { data, anchor, content } = Astro.props;
const today = todayISO();
const tones: Tone[] = ['pink', 'teal', 'violet'];

const events = content.events
  .filter((e) => !data.hideExpired || !e.endsAt || e.endsAt >= today)
  .map((e, i) => ({
    ...e,
    tone: tones[i % tones.length],
    live: !!e.startsAt && e.startsAt <= today && (!e.endsAt || e.endsAt >= today),
    date: e.startsAt ? dayAndMonth(e.startsAt) : null,
    range: formatDateRange(e.startsAt, e.endsAt),
  }));
---

{
  events.length > 0 && (
    <section class="section events" id={anchor ?? undefined} data-events>
      <div class="events__pin" data-pin>
      <div class="events__stage" data-stage>
      <div class="container-site events__head">
        <SectionHeading eyebrow={data.eyebrow} title={data.title} subtitle={data.subtitle} />
        <div class="events__controls" data-reveal>
          <button type="button" class="round-btn" aria-label="Evento anterior" data-carousel-prev>
            <Icon name="chevron-left" size={22} />
          </button>
          <button type="button" class="round-btn" aria-label="Próximo evento" data-carousel-next>
            <Icon name="chevron-right" size={22} />
          </button>
        </div>
      </div>

      <div
        class="events__viewport"
        data-carousel
        tabindex="0"
        role="region"
        aria-roledescription="carrossel"
        aria-label="Agenda de eventos"
      >
        <ul class="events__track" role="list">
          {events.map((e, i) => (
            <li class="event-card" data-tone={e.tone} data-reveal style={`--delay:${Math.min(i, 3) * 90}ms`}>
              <article>
                <div class="event-card__media media-frame">
                  {e.imageUrl && <img src={e.imageUrl} alt="" loading="lazy" decoding="async" />}
                  {e.date && (
                    <span class="event-card__date" aria-hidden="true">
                      <strong>{e.date.day}</strong>
                      <span>{e.date.month}</span>
                    </span>
                  )}
                  {e.live && <span class="event-card__live">Acontecendo agora</span>}
                </div>
                <div class="event-card__body">
                  {e.tag && <span class="event-card__tag">{e.tag}</span>}
                  <h3>{e.title}</h3>
                  {e.range && (
                    <p class="event-card__when">
                      <Icon name="calendar" size={16} />
                      <span>{e.range}</span>
                    </p>
                  )}
                  {e.description && <p class="event-card__desc">{e.description}</p>}
                  {e.ctaUrl && e.ctaLabel && (
                    <a class="link-arrow event-card__cta" href={e.ctaUrl}>
                      {e.ctaLabel}
                      <Icon name="arrow-up-right" size={18} />
                    </a>
                  )}
                </div>
              </article>
            </li>
          ))}
        </ul>
      </div>

      <div class="container-site">
        <div class="events__progress" aria-hidden="true">
          <span data-carousel-progress />
        </div>
      </div>
      </div>
      </div>
    </section>
  )
}

<style>
  .events__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem 2rem;
  }
  .events__controls {
    display: flex;
    gap: 0.5rem;
  }
  .events__controls[hidden] {
    display: none;
  }
  .round-btn {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    background: var(--color-surface);
    box-shadow: inset 0 0 0 1px var(--color-line);
    color: var(--color-ink);
    transition:
      background-color 0.2s ease,
      opacity 0.2s ease,
      transform 0.35s var(--ease-spring);
  }
  .round-btn:hover:not(:disabled) {
    background: var(--color-surface-2);
  }
  .round-btn:active:not(:disabled) {
    transform: scale(0.94);
  }
  .round-btn:disabled {
    opacity: 0.38;
    cursor: not-allowed;
  }

  /* trilho alinhado ao container à esquerda e "sangrando" à direita.
     padding/margin vertical evitam cortar o hover (lift + sombra) dos cards */
  .events__viewport {
    --edge: max(var(--gutter), calc((100vw - 1280px) / 2 + var(--gutter)));
    margin-block: calc(clamp(2.5rem, 5vw, 3.5rem) - 1.5rem) -1rem;
    padding-block: 1.5rem 2rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--edge);
    scrollbar-width: none;
  }
  .events__viewport::-webkit-scrollbar {
    display: none;
  }
  .events__viewport:focus-visible {
    outline-offset: -3px;
  }
  .events__track {
    display: flex;
    gap: 1rem;
    width: max-content;
    padding-inline: var(--edge);
  }

  /* ---------- modo cinematográfico: o scroll vertical conduz o trilho ---------- */
  .events.is-pinned {
    padding-block: 0;
  }
  .events.is-pinned .events__stage {
    position: sticky;
    top: 0;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: calc(var(--header-h) + 1rem) 2.5rem;
    overflow: clip;
  }
  .events.is-pinned .events__viewport {
    overflow: visible;
    scroll-snap-type: none;
    margin-block: clamp(1rem, 3vh, 2.5rem) 0;
    padding-block: 1.5rem;
  }
  .events.is-pinned .events__track {
    gap: clamp(1rem, 2vw, 1.75rem);
    will-change: transform;
    transform: translate3d(var(--pin-x, 0px), 0, 0);
  }
  .events.is-pinned .event-card {
    width: clamp(17rem, 27vw, 24rem);
  }
  .events.is-pinned .event-card__media img {
    width: 112%;
    max-width: none;
    height: 100%;
    object-fit: cover;
    transform: translate3d(calc(var(--par, 0) * -6%), 0, 0);
    transition: none;
  }
  .events.is-pinned .event-card article:hover .event-card__media img {
    transform: translate3d(calc(var(--par, 0) * -6%), 0, 0);
  }
  .events.is-pinned .events__progress {
    margin-top: 1.5rem;
  }

  .event-card {
    display: flex;
    width: min(84vw, 23.5rem);
    scroll-snap-align: start;
  }
  .event-card article {
    display: flex;
    flex-direction: column;
    width: 100%;
    border-radius: var(--radius-card);
    background: var(--color-surface);
    box-shadow: inset 0 0 0 1px var(--color-line);
    overflow: hidden;
    transition: transform 0.5s var(--ease-spring), box-shadow 0.3s ease;
  }
  .event-card article:hover {
    transform: translateY(-4px);
    box-shadow:
      inset 0 0 0 1px color-mix(in srgb, var(--tone) 50%, transparent),
      0 24px 44px -26px color-mix(in srgb, var(--tone) 55%, transparent);
  }

  .event-card__media {
    aspect-ratio: 4 / 3;
    margin: 0.5rem 0.5rem 0;
    border-radius: calc(var(--radius-card) - 0.5rem);
  }
  .event-card__media img {
    transition: transform 0.9s var(--ease-out-expo);
  }
  .event-card article:hover .event-card__media img {
    transform: scale(1.05);
  }
  .event-card__date {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    display: grid;
    justify-items: center;
    min-width: 3.75rem;
    padding: 0.5rem 0.625rem 0.625rem;
    border-radius: 1rem;
    background: var(--color-ink);
    color: var(--color-on-accent);
    line-height: 1;
  }
  .event-card__date strong {
    font-family: var(--font-display);
    font-size: 1.625rem;
    font-weight: 900;
    letter-spacing: -0.04em;
  }
  .event-card__date span {
    margin-top: 0.25rem;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .event-card__live {
    position: absolute;
    top: 0.875rem;
    right: 0.875rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 0.75rem;
    border-radius: 999px;
    background: rgb(35 32 33 / 0.8);
    backdrop-filter: blur(8px);
    font-size: 0.75rem;
    font-weight: 700;
  }
  .event-card__live::before {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-pink);
    animation: pulse 1.6s ease-in-out infinite;
  }
  @keyframes pulse {
    50% {
      box-shadow: 0 0 0 6px rgb(240 95 142 / 0);
      opacity: 0.6;
    }
  }

  .event-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    flex: 1;
    padding: 1.25rem 1.375rem 1.5rem;
  }
  .event-card__tag {
    align-self: flex-start;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    background: var(--tone-soft);
    color: var(--tone);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .event-card h3 {
    font-size: 1.5rem;
    font-weight: 800;
  }
  .event-card__when {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-ink-soft);
  }
  .event-card__desc {
    font-size: 0.9375rem;
    color: var(--color-ink-muted);
  }
  .event-card__cta {
    margin-top: auto;
    padding-top: 0.5rem;
    color: var(--tone);
  }

  .events__progress {
    position: relative;
    height: 2px;
    margin-top: 2rem;
    border-radius: 2px;
    background: var(--color-line);
    overflow: hidden;
  }
  .events__progress span {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, var(--color-pink), var(--color-teal));
    transform-origin: 0 50%;
    transform: scaleX(var(--carousel-p, 0.2));
    transition: transform 0.2s linear;
  }
</style>


<script>
  const section = document.querySelector<HTMLElement>('[data-events]');
  const viewport = section?.querySelector<HTMLElement>('[data-carousel]');
  const track = viewport?.querySelector<HTMLElement>('.events__track');

  if (section && viewport && track) {
    const pin = section.querySelector<HTMLElement>('[data-pin]')!;
    const stage = section.querySelector<HTMLElement>('[data-stage]')!;
    const prev = section.querySelector<HTMLButtonElement>('[data-carousel-prev]');
    const next = section.querySelector<HTMLButtonElement>('[data-carousel-next]');
    const bar = section.querySelector<HTMLElement>('[data-carousel-progress]');
    const controls = section.querySelector<HTMLElement>('.events__controls');
    const cards = Array.from(track.querySelectorAll<HTMLElement>('.event-card'));

    const wide = matchMedia('(min-width: 768px) and (hover: hover) and (pointer: fine)');
    const calm = matchMedia('(prefers-reduced-motion: reduce)');
    const gap = () => parseFloat(getComputedStyle(track).columnGap) || 16;
    const step = () => (cards[0] ? cards[0].offsetWidth + gap() : viewport.clientWidth * 0.8);

    // modo nativo (mobile / toque / movimento reduzido): scroll horizontal com snap
    const syncNative = () => {
      const max = viewport.scrollWidth - viewport.clientWidth;
      const x = viewport.scrollLeft;
      if (prev) prev.disabled = x <= 4;
      if (next) next.disabled = x >= max - 4;
      const visible = viewport.clientWidth / viewport.scrollWidth;
      const p = max > 0 ? visible + (1 - visible) * (x / max) : 1;
      bar?.style.setProperty('--carousel-p', p.toFixed(3));
      controls?.toggleAttribute('hidden', max <= 4);
    };

    // modo fixo: o scroll vertical (e o horizontal) conduz o trilho com inércia
    let pinned = false;
    let maxX = 0; // deslocamento total do trilho
    let travel = 0; // scroll vertical equivalente
    let top = 0; // scrollY em que o palco gruda
    let current = 0; // progresso suavizado 0..1
    let raf = 0;

    const target = () => Math.min(1, Math.max(0, (scrollY - top) / (travel || 1)));

    const paint = () => {
      track.style.setProperty('--pin-x', `${(-current * maxX).toFixed(2)}px`);
      bar?.style.setProperty('--carousel-p', (0.12 + 0.88 * current).toFixed(3));
      if (prev) prev.disabled = current <= 0.005;
      if (next) next.disabled = current >= 0.995;
      for (const c of cards) {
        const r = c.getBoundingClientRect();
        const center = (r.left + r.width / 2) / innerWidth;
        c.style.setProperty('--par', ((center - 0.5) * 2).toFixed(3));
      }
    };

    const tick = () => {
      const t = target();
      current += (t - current) * 0.1;
      if (Math.abs(t - current) < 0.0004) current = t;
      paint();
      raf = current === t ? 0 : requestAnimationFrame(tick);
    };
    const kick = () => {
      if (pinned && !raf) raf = requestAnimationFrame(tick);
    };

    const measure = () => {
      const edge = parseFloat(getComputedStyle(viewport).getPropertyValue('--edge')) || 0;
      maxX = Math.max(0, track.scrollWidth - innerWidth + edge * 0.4);
      travel = maxX * 1.1;
      pin.style.height = `${stage.offsetHeight + travel}px`;
      top = pin.getBoundingClientRect().top + scrollY;
    };

    const disable = () => {
      pinned = false;
      cancelAnimationFrame(raf);
      raf = 0;
      section.classList.remove('is-pinned');
      pin.style.height = '';
      track.style.removeProperty('--pin-x');
      cards.forEach((c) => c.style.removeProperty('--par'));
      syncNative();
    };
    const enable = () => {
      pinned = true;
      section.classList.add('is-pinned');
      viewport.scrollLeft = 0;
      pin.style.height = '';
      // conteúdo mais alto que a tela não pode grudar: volta ao modo nativo
      if (stage.offsetHeight > innerHeight + 2) return disable();
      measure();
      current = target();
      controls?.removeAttribute('hidden');
      paint();
    };
    const evaluate = () => (wide.matches && !calm.matches ? enable() : disable());

    const go = (dir: 1 | -1) => {
      if (pinned) {
        const dy = (step() / (maxX || 1)) * travel * dir;
        scrollTo({ top: Math.min(top + travel, Math.max(top, scrollY + dy)), behavior: 'smooth' });
      } else {
        viewport.scrollBy({ left: step() * dir, behavior: 'smooth' });
      }
    };

    prev?.addEventListener('click', () => go(-1));
    next?.addEventListener('click', () => go(1));
    viewport.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') (e.preventDefault(), go(1));
      if (e.key === 'ArrowLeft') (e.preventDefault(), go(-1));
    });
    viewport.addEventListener('scroll', () => !pinned && requestAnimationFrame(syncNative), { passive: true });

    // gesto horizontal (trackpad / shift+roda) também conduz o carrossel
    addEventListener(
      'wheel',
      (e) => {
        if (!pinned || e.ctrlKey || Math.abs(e.deltaX) <= Math.abs(e.deltaY)) return;
        const t = target();
        const inside = scrollY >= top - 1 && scrollY <= top + travel + 1;
        if (!inside || (t <= 0 && e.deltaX < 0) || (t >= 1 && e.deltaX > 0)) return;
        e.preventDefault();
        scrollBy({ top: e.deltaX * (travel / (maxX || 1)), behavior: 'instant' });
      },
      { passive: false },
    );

    addEventListener('scroll', kick, { passive: true });
    addEventListener('resize', () => (pinned ? evaluate() : syncNative()));
    wide.addEventListener('change', evaluate);
    calm.addEventListener('change', evaluate);
    addEventListener('load', () => pinned && (measure(), kick()));
    document.fonts?.ready.then(() => pinned && (measure(), kick()));
    evaluate();
  }
</script>
