---
import Icon from '../ui/Icon.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { dayAndMonth, formatDateRange, todayISO } from '../../lib/text';
import type { SectionData, SiteContent, Tone } from '../../lib/content/schema';

interface Props {
  data: SectionData<'events'>;
  anchor: string | null;
  content: SiteContent;
}

const { data, anchor, content } = Astro.props;
const today = todayISO();
const tones: Tone[] = ['pink', 'teal', 'violet'];

const events = content.events
  .filter((e) => !data.hideExpired || !e.endsAt || e.endsAt >= today)
  .map((e, i) => ({
    ...e,
    tone: tones[i % tones.length],
    live: !!e.startsAt && e.startsAt <= today && (!e.endsAt || e.endsAt >= today),
    date: e.startsAt ? dayAndMonth(e.startsAt) : null,
    range: formatDateRange(e.startsAt, e.endsAt),
  }));
---

{
  events.length > 0 && (
    <section class="section events" id={anchor ?? undefined}>
      <div class="container-site events__head">
        <SectionHeading eyebrow={data.eyebrow} title={data.title} subtitle={data.subtitle} />
        <div class="events__controls" data-reveal>
          <button type="button" class="round-btn" aria-label="Evento anterior" data-carousel-prev>
            <Icon name="chevron-left" size={22} />
          </button>
          <button type="button" class="round-btn" aria-label="Próximo evento" data-carousel-next>
            <Icon name="chevron-right" size={22} />
          </button>
        </div>
      </div>

      <div
        class="events__viewport"
        data-carousel
        tabindex="0"
        role="region"
        aria-roledescription="carrossel"
        aria-label="Agenda de eventos"
      >
        <ul class="events__track" role="list">
          {events.map((e, i) => (
            <li class="event-card" data-tone={e.tone} data-reveal style={`--delay:${Math.min(i, 3) * 90}ms`}>
              <article>
                <div class="event-card__media media-frame">
                  {e.imageUrl && <img src={e.imageUrl} alt="" loading="lazy" decoding="async" />}
                  {e.date && (
                    <span class="event-card__date" aria-hidden="true">
                      <strong>{e.date.day}</strong>
                      <span>{e.date.month}</span>
                    </span>
                  )}
                  {e.live && <span class="event-card__live">Acontecendo agora</span>}
                </div>
                <div class="event-card__body">
                  {e.tag && <span class="event-card__tag">{e.tag}</span>}
                  <h3>{e.title}</h3>
                  {e.range && (
                    <p class="event-card__when">
                      <Icon name="calendar" size={16} />
                      <span>{e.range}</span>
                    </p>
                  )}
                  {e.description && <p class="event-card__desc">{e.description}</p>}
                  {e.ctaUrl && e.ctaLabel && (
                    <a class="link-arrow event-card__cta" href={e.ctaUrl}>
                      {e.ctaLabel}
                      <Icon name="arrow-up-right" size={18} />
                    </a>
                  )}
                </div>
              </article>
            </li>
          ))}
        </ul>
      </div>

      <div class="container-site">
        <div class="events__progress" aria-hidden="true">
          <span data-carousel-progress />
        </div>
      </div>
    </section>
  )
}

<style>
  .events__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem 2rem;
  }
  .events__controls {
    display: flex;
    gap: 0.5rem;
  }
  .events__controls[hidden] {
    display: none;
  }
  .round-btn {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    background: var(--color-surface);
    box-shadow: inset 0 0 0 1px var(--color-line);
    color: var(--color-ink);
    transition:
      background-color 0.2s ease,
      opacity 0.2s ease,
      transform 0.35s var(--ease-spring);
  }
  .round-btn:hover:not(:disabled) {
    background: var(--color-surface-2);
  }
  .round-btn:active:not(:disabled) {
    transform: scale(0.94);
  }
  .round-btn:disabled {
    opacity: 0.38;
    cursor: not-allowed;
  }

  /* trilho alinhado ao container à esquerda e "sangrando" à direita */
  .events__viewport {
    --edge: max(var(--gutter), calc((100vw - 1280px) / 2 + var(--gutter)));
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--edge);
    scrollbar-width: none;
    border-radius: 0;
  }
  .events__viewport::-webkit-scrollbar {
    display: none;
  }
  .events__viewport:focus-visible {
    outline-offset: -3px;
  }
  .events__track {
    display: flex;
    gap: 1rem;
    width: max-content;
    padding-inline: var(--edge);
    padding-bottom: 0.5rem;
  }

  .event-card {
    display: flex;
    width: min(84vw, 23.5rem);
    scroll-snap-align: start;
  }
  .event-card article {
    display: flex;
    flex-direction: column;
    width: 100%;
    border-radius: var(--radius-card);
    background: var(--color-surface);
    box-shadow: inset 0 0 0 1px var(--color-line);
    overflow: hidden;
    transition: transform 0.5s var(--ease-spring), box-shadow 0.3s ease;
  }
  .event-card article:hover {
    transform: translateY(-4px);
    box-shadow:
      inset 0 0 0 1px color-mix(in srgb, var(--tone) 50%, transparent),
      0 24px 44px -26px color-mix(in srgb, var(--tone) 55%, transparent);
  }

  .event-card__media {
    aspect-ratio: 4 / 3;
    margin: 0.5rem 0.5rem 0;
    border-radius: calc(var(--radius-card) - 0.5rem);
  }
  .event-card__media img {
    transition: transform 0.9s var(--ease-out-expo);
  }
  .event-card article:hover .event-card__media img {
    transform: scale(1.05);
  }
  .event-card__date {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    display: grid;
    justify-items: center;
    min-width: 3.75rem;
    padding: 0.5rem 0.625rem 0.625rem;
    border-radius: 1rem;
    background: var(--color-ink);
    color: var(--color-on-accent);
    line-height: 1;
  }
  .event-card__date strong {
    font-family: var(--font-display);
    font-size: 1.625rem;
    font-weight: 900;
    letter-spacing: -0.04em;
  }
  .event-card__date span {
    margin-top: 0.25rem;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .event-card__live {
    position: absolute;
    top: 0.875rem;
    right: 0.875rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 0.75rem;
    border-radius: 999px;
    background: rgb(35 32 33 / 0.8);
    backdrop-filter: blur(8px);
    font-size: 0.75rem;
    font-weight: 700;
  }
  .event-card__live::before {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-pink);
    animation: pulse 1.6s ease-in-out infinite;
  }
  @keyframes pulse {
    50% {
      box-shadow: 0 0 0 6px rgb(240 95 142 / 0);
      opacity: 0.6;
    }
  }

  .event-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    flex: 1;
    padding: 1.25rem 1.375rem 1.5rem;
  }
  .event-card__tag {
    align-self: flex-start;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    background: var(--tone-soft);
    color: var(--tone);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .event-card h3 {
    font-size: 1.5rem;
    font-weight: 800;
  }
  .event-card__when {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-ink-soft);
  }
  .event-card__desc {
    font-size: 0.9375rem;
    color: var(--color-ink-muted);
  }
  .event-card__cta {
    margin-top: auto;
    padding-top: 0.5rem;
    color: var(--tone);
  }

  .events__progress {
    position: relative;
    height: 2px;
    margin-top: 2rem;
    border-radius: 2px;
    background: var(--color-line);
    overflow: hidden;
  }
  .events__progress span {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, var(--color-pink), var(--color-teal));
    transform-origin: 0 50%;
    transform: scaleX(var(--carousel-p, 0.2));
    transition: transform 0.2s linear;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((viewport) => {
    const section = viewport.closest('section');
    const prev = section?.querySelector<HTMLButtonElement>('[data-carousel-prev]');
    const next = section?.querySelector<HTMLButtonElement>('[data-carousel-next]');
    const bar = section?.querySelector<HTMLElement>('[data-carousel-progress]');

    const step = () => {
      const card = viewport.querySelector<HTMLElement>('.event-card');
      return card ? card.offsetWidth + 16 : viewport.clientWidth * 0.8;
    };

    const sync = () => {
      const max = viewport.scrollWidth - viewport.clientWidth;
      const x = viewport.scrollLeft;
      if (prev) prev.disabled = x <= 4;
      if (next) next.disabled = x >= max - 4;
      const visible = viewport.clientWidth / viewport.scrollWidth;
      const p = max > 0 ? visible + (1 - visible) * (x / max) : 1;
      bar?.style.setProperty('--carousel-p', p.toFixed(3));
      if (section && max <= 4) section.querySelector('.events__controls')?.setAttribute('hidden', '');
    };

    prev?.addEventListener('click', () => viewport.scrollBy({ left: -step(), behavior: 'smooth' }));
    next?.addEventListener('click', () => viewport.scrollBy({ left: step(), behavior: 'smooth' }));
    viewport.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') viewport.scrollBy({ left: step(), behavior: 'smooth' });
      if (e.key === 'ArrowLeft') viewport.scrollBy({ left: -step(), behavior: 'smooth' });
    });
    viewport.addEventListener('scroll', () => requestAnimationFrame(sync), { passive: true });
    window.addEventListener('resize', sync);
    sync();
  });
</script>
