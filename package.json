{
  "name": "design-mall",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "deploy": "astro build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:seed:generate": "node scripts/generate-seed.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed:local": "wrangler d1 execute DB --local --file=./db/seed.sql",
    "db:seed:remote": "wrangler d1 execute DB --remote --file=./db/seed.sql",
    "db:setup:local": "npm run db:seed:generate && npm run db:migrate:local && npm run db:seed:local"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "@fontsource-variable/red-hat-display": "^5.3.0",
    "@fontsource-variable/red-hat-text": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^5.9.3",
    "wrangler": "^4.147.0"
  }
}
